<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="kolmas_view.MainPage">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <!-- Status Bars -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,20">
            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="Hunger" FontSize="16" FontAttributes="Bold"/>
                <ProgressBar x:Name="HungerBar" Progress="1" HeightRequest="20"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="5">
                <Label Text="Fun" FontSize="16" FontAttributes="Bold"/>
                <ProgressBar x:Name="FunBar" Progress="1" HeightRequest="20"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="5">
                <Label Text="Clean" FontSize="16" FontAttributes="Bold"/>
                <ProgressBar x:Name="CleanBar" Progress="1" HeightRequest="20"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Creature Display -->
        <Frame Grid.Row="1" 
               CornerRadius="20" 
               Padding="0"
               BackgroundColor="LightGray"
               HorizontalOptions="Center"
               VerticalOptions="Center">
            <Image x:Name="CreatureImage" 
                   Source="dotnet_bot.png"
                   HeightRequest="200"
                   WidthRequest="200"
                   Aspect="AspectFit"/>
        </Frame>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,20,0,0">
            <Button Grid.Column="0" 
                    Text="Feed" 
                    x:Name="FeedButton"
                    Clicked="OnFeedClicked"
                    Margin="0,0,10,0"/>
            <Button Grid.Column="1" 
                    Text="Play" 
                    x:Name="PlayButton"
                    Clicked="OnPlayClicked"
                    Margin="10,0,10,0"/>
            <Button Grid.Column="2" 
                    Text="Clean" 
                    x:Name="CleanButton"
                    Clicked="OnCleanClicked"
                    Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</ContentPage>
